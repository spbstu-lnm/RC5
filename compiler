#!/usr/bin/env python3
"""Compile simple.vm assembly to bytecode, optionally with label metadata."""
import argparse
import hashlib
import json
import re
import sys
from pathlib import Path

OP = {"exit":0x00,"int_store":0x01,"int_print":0x02,"int_tostring":0x03,"int_random":0x04,"jmp":0x10,"jmpz":0x11,"jmpnz":0x12,"xor":0x20,"add":0x21,"sub":0x22,"mul":0x23,"div":0x24,"inc":0x25,"dec":0x26,"and":0x27,"or":0x28,"string_store":0x30,"string_print":0x31,"concat":0x32,"system":0x33,"string_toint":0x34,"cmp_reg":0x40,"cmp_immediate":0x41,"cmp_string":0x42,"is_string":0x43,"is_integer":0x44,"nop":0x50,"reg_store":0x51,"peek":0x60,"poke":0x61,"memcpy":0x62,"push":0x70,"pop":0x71,"ret":0x72,"call":0x73}

class CompileError(Exception): pass
def b(value, what="byte"):
    if not 0 <= value <= 255: raise CompileError(f"{what} must fit in one byte: {value}")
    return value
def w(value, what="value"):
    if not 0 <= value <= 65535: raise CompileError(f"{what} must fit in 16 bits: {value}")
    return value.to_bytes(2, "little")
def num(value): return int(value, 16) if value.lower().startswith("0x") else int(value)
def address(value): return bool(re.fullmatch(r"0[xX][0-9a-fA-F]+|[0-9]+", value))
def string(value):
    try: return value.replace(r"\n", "\n").replace(r"\t", "\t").encode("latin-1")
    except UnicodeEncodeError as exc: raise CompileError("string contains characters outside the byte range") from exc

def compile_file(source):
    try: lines = source.read_bytes().decode("latin-1").splitlines()
    except OSError as exc: raise CompileError(f"Failed to read source {source} - {exc}") from exc
    code, labels, updates = bytearray(), {}, []
    def emit(*items): code.extend(b(x) for x in items)
    def emit_target(op, target):
        emit(op)
        if address(target): code.extend(w(num(target), "address"))
        else: updates.append((len(code), target)); code.extend(b"\0\0")
    for lineno, line in enumerate(lines, 1):
        if not line or re.match(r"^\s*#", line): continue
        m = re.match(r"^\s*:(.*)", line)
        if m:
            name = m.group(1)
            if any(x["name"] == name or name in x["aliases"] for x in labels.values()):
                print(f"WARNING: Label name '{name}' defined multiple times!\n         Picking first occurrence.", file=sys.stderr); continue
            if re.match(r"^(?:0x|[0-9]+$)", name, re.I): print(f"WARNING: Label named '{name}' WILL be confused for an address", file=sys.stderr)
            key = str(len(code))
            if key in labels: labels[key]["aliases"].append(name)
            else: labels[key] = {"name":name, "aliases":[], "source":{"line":lineno}}
            continue
        m = re.match(r'^\s+store\s+#([0-9]+)\s?,\s?"([^"]*)"', line)
        if m:
            value = string(m.group(2)); emit(OP["string_store"], num(m.group(1))); code.extend(w(len(value), "string length")); code.extend(value); continue
        m = re.match(r"^\s+store\s+#([0-9]+)\s?,\s?#([0-9]+)", line)
        if m: emit(OP["reg_store"], num(m.group(1)), num(m.group(2))); continue
        m = re.match(r"^\s+store\s+#([0-9]+)\s?,\s?([^\s]+)", line)
        if m:
            emit(OP["int_store"], num(m.group(1))); target=m.group(2)
            if address(target): code.extend(w(num(target), "integer"))
            else: updates.append((len(code), target)); code.extend(b"\0\0")
            continue
        if re.match(r"^\s+exit", line): emit(OP["exit"]); continue
        if re.match(r"^\s+nop", line): emit(OP["nop"]); continue
        m = re.match(r"^\s*(print_int|print_str|system)\s?#(.*)", line)
        if m: emit(OP[{"print_int":"int_print","print_str":"string_print","system":"system"}[m.group(1)]], num(m.group(2))); continue
        m = re.match(r"^\s*(goto|jmp|jmpz|jmpnz|call)\s+([^\s]+)", line)
        if m: emit_target(OP[{"goto":"jmp","jmp":"jmp","jmpz":"jmpz","jmpnz":"jmpnz","call":"call"}[m.group(1)]], m.group(2)); continue
        m = re.match(r"^\s*(add|and|sub|mul|div|or|xor|concat)\s+#([0-9]+)\s*,\s*#([0-9]+)\s*,\s*#([0-9]+)", line)
        if m: emit(OP[m.group(1)], *map(num, m.groups()[1:])); continue
        m = re.match(r"^\s*(dec|inc|int2string|random|string2int)\s+#([0-9]+)", line)
        if m: emit(OP[{"dec":"dec","inc":"inc","int2string":"int_tostring","random":"int_random","string2int":"string_toint"}[m.group(1)]], num(m.group(2))); continue
        m = re.match(r"^\s*cmp\s+#([0-9]+)\s*,\s*#([0-9]+)\s*", line, re.I)
        if m: emit(OP["cmp_reg"], num(m.group(1)), num(m.group(2))); continue
        m = re.match(r'^\s+cmp\s+#([0-9]+)\s?,\s?"([^"]*)"', line)
        if m:
            value=string(m.group(2)); emit(OP["cmp_string"],num(m.group(1))); code.extend(w(len(value),"string length")); code.extend(value); continue
        m = re.match(r"^\s*cmp\s+#([0-9]+)\s*,\s*([^\s]+)\s*", line, re.I)
        if m: emit(OP["cmp_immediate"],num(m.group(1))); code.extend(w(num(m.group(2)), "integer")); continue
        m = re.match(r"^\s*is_(string|integer)\s+#([0-9]+)", line)
        if m: emit(OP["is_"+m.group(1)],num(m.group(2))); continue
        m = re.match(r"^\s*(peek|poke)\s+#([0-9]+)\s*,\s*#([0-9]+)", line)
        if m: emit(OP[m.group(1)],num(m.group(2)),num(m.group(3))); continue
        m = re.match(r"^\s*memcpy\s+#([0-9]+)\s*,\s*#([0-9]+)\s*,\s*#([0-9]+)", line)
        if m: emit(OP["memcpy"],*map(num,m.groups())); continue
        m = re.match(r"^\s*(push|pop)\s+#([0-9]+)", line)
        if m: emit(OP[m.group(1)],num(m.group(2))); continue
        if re.match(r"^\s*ret\s*", line): emit(OP["ret"]); continue
        m = re.match(r"^\s*(?:db|data)\s+(.*)", line, re.I)
        if m:
            for value in m.group(1).split(","):
                if value.strip(): emit(num(value.strip()))
            continue
        print(f"WARNING UNKNOWN LINE: {line}", file=sys.stderr)
    if not code: print("WARNING: Didn't generate any code", file=sys.stderr)
    names={entry["name"]:int(offset) for offset,entry in labels.items()}
    names.update({alias:int(offset) for offset,entry in labels.items() for alias in entry["aliases"]})
    for offset, name in updates:
        if name not in names: raise CompileError(f"No target for label '{name}' - Label not defined!")
        code[offset:offset+2]=w(names[name],"label address")
    return bytes(code), labels

def main():
    parser=argparse.ArgumentParser(description="Compile simple.vm assembly to bytecode.")
    parser.add_argument("sources",nargs="+",type=Path)
    parser.add_argument("--labels-json",action="store_true",help="write metadata as <output>.labels.json")
    parser.add_argument("--labels-json-file",type=Path,metavar="FILE",help="write metadata to FILE (one source only)")
    args=parser.parse_args()
    if args.labels_json_file and len(args.sources)!=1: parser.error("--labels-json-file requires exactly one source")
    try:
        for source in args.sources:
            code,labels=compile_file(source); output=source.with_suffix(".raw"); output.write_bytes(code)
            if args.labels_json or args.labels_json_file:
                path=args.labels_json_file or output.with_suffix(".labels.json")
                doc={"format":"simple-vm-labels","version":1,"bytecode":{"file":output.name,"sha256":hashlib.sha256(code).hexdigest(),"size":len(code)},"labels":labels}
                path.write_text(json.dumps(doc,ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
    except (CompileError,OSError,ValueError) as exc: print(f"compiler: {exc}",file=sys.stderr); return 1
    return 0
if __name__=="__main__": raise SystemExit(main())

#!/usr/bin/env python3
"""Decompile simple.vm bytecode, with optional restoration of label names."""
import argparse
import hashlib
import json
import sys
from pathlib import Path

class DecompileError(Exception): pass
def word(data, pos):
    if pos+2 > len(data): raise DecompileError(f"truncated 16-bit argument at 0x{pos:04X}")
    return data[pos] | data[pos+1] << 8
def need(data,pos,count):
    if pos+count > len(data): raise DecompileError(f"truncated instruction at 0x{pos:04X}")
def quote(raw):
    # These are exactly the escapes understood by the legacy Perl compiler.
    return raw.decode("latin-1").replace("\n",r"\n").replace("\t",r"\t")
def load_labels(path, bytecode):
    try: doc=json.loads(path.read_text(encoding="utf-8"))
    except (OSError,json.JSONDecodeError) as exc: raise DecompileError(f"cannot read label metadata {path}: {exc}") from exc
    if doc.get("format")!="simple-vm-labels" or doc.get("version")!=1: raise DecompileError("unsupported label metadata format")
    info=doc.get("bytecode",{})
    if info.get("sha256") != hashlib.sha256(bytecode).hexdigest() or info.get("size") != len(bytecode): raise DecompileError("label metadata does not match this bytecode (hash or size differs)")
    labels={}
    for address, entry in doc.get("labels",{}).items():
        try: offset=int(address)
        except ValueError as exc: raise DecompileError(f"invalid label address: {address}") from exc
        if not 0 <= offset <= len(bytecode) or not isinstance(entry.get("name"),str): raise DecompileError(f"invalid label at address {address}")
        labels[offset]=entry["name"]
    return labels

def decompile(data, labels, show_address):
    pos=0
    while pos < len(data):
        start=pos
        if start in labels:
            yield (f"{start:04X}" if show_address else "") + f":{labels[start]}\n"
        opcode=data[pos]; pos+=1
        prefix=f"{start:04X}" if show_address else ""
        def out(text): return prefix+"\t"+text+"\n"
        def reg1(name):
            nonlocal pos
            need(data,pos,1); value=data[pos]; pos+=1; return out(f"{name} #{value}")
        def regs3(name):
            nonlocal pos
            need(data,pos,3); a,b,c=data[pos:pos+3]; pos+=3; return out(f"{name} #{a}, #{b}, #{c}")
        if opcode==0x00: yield out("exit")
        elif opcode==0x01:
            need(data,pos,3); r=data[pos]; value=word(data,pos+1); pos+=3; yield out(f"store #{r}, 0x{value:04X}")
        elif opcode==0x02: yield reg1("print_int")
        elif opcode==0x03: yield reg1("int2string")
        elif opcode==0x04: yield reg1("random")
        elif opcode in (0x10,0x11,0x12,0x73):
            value=word(data,pos); pos+=2
            name={0x10:"jmp",0x11:"jmpz",0x12:"jmpnz",0x73:"call"}[opcode]
            target=labels.get(value, f"0x{value:04X}")
            yield out(f"{name} {target}")
        elif opcode in (0x20,0x21,0x22,0x23,0x24,0x27,0x28,0x32):
            yield regs3({0x20:"xor",0x21:"add",0x22:"sub",0x23:"mul",0x24:"div",0x27:"and",0x28:"or",0x32:"concat"}[opcode])
        elif opcode==0x25: yield reg1("inc")
        elif opcode==0x26: yield reg1("dec")
        elif opcode in (0x30,0x42):
            need(data,pos,3); reg=data[pos]; length=word(data,pos+1); pos+=3; need(data,pos,length); value=data[pos:pos+length]; pos+=length
            yield out((f"store #{reg}, \"{quote(value)}\"" if opcode==0x30 else f"cmp #{reg}, \"{quote(value)}\""))
        elif opcode==0x31: yield reg1("print_str")
        elif opcode==0x33: yield reg1("system")
        elif opcode==0x34: yield reg1("string2int")
        elif opcode==0x40:
            need(data,pos,2); a,b=data[pos:pos+2]; pos+=2; yield out(f"cmp #{a},#{b}")
        elif opcode==0x41:
            need(data,pos,3); r=data[pos]; value=word(data,pos+1); pos+=3; yield out(f"cmp #{r},0x{value:04X}")
        elif opcode==0x43: yield reg1("is_string")
        elif opcode==0x44: yield reg1("is_integer")
        elif opcode==0x50: yield out("nop")
        elif opcode==0x51:
            need(data,pos,2); a,b=data[pos:pos+2]; pos+=2; yield out(f"store #{a},#{b}")
        elif opcode in (0x60,0x61):
            need(data,pos,2); a,b=data[pos:pos+2]; pos+=2; yield out(f"{'peek' if opcode==0x60 else 'poke'} #{a}, #{b}")
        elif opcode==0x62: yield regs3("memcpy")
        elif opcode==0x70: yield reg1("push")
        elif opcode==0x71: yield reg1("pop")
        elif opcode==0x72: yield out("ret")
        else: yield out(f"DATA {opcode}")
    if pos in labels:
        yield (f"{pos:04X}" if show_address else "") + f":{labels[pos]}\n"

def main():
    parser=argparse.ArgumentParser(description="Decompile simple.vm bytecode.")
    parser.add_argument("--show-address",action="store_true")
    parser.add_argument("--labels-json",type=Path,metavar="FILE",help="restore labels from compiler metadata")
    parser.add_argument("files",nargs="+",type=Path)
    args=parser.parse_args()
    if args.labels_json and len(args.files)!=1: parser.error("--labels-json requires exactly one bytecode file")
    try:
        for path in args.files:
            data=path.read_bytes(); labels=load_labels(args.labels_json,data) if args.labels_json else {}
            sys.stdout.write("".join(decompile(data,labels,args.show_address)))
    except (OSError,DecompileError) as exc: print(f"decompiler: {exc}",file=sys.stderr); return 1
    return 0
if __name__=="__main__": raise SystemExit(main())
